  "version": "0.2.0",
  "configurations": [
  
    {
      // will run with a ds size of 32, so pretty fast
      "name": "cot debug",
      "type": "debugpy",
      "request": "launch",
      "program": "./scripts/run.py",
      "console": "integratedTerminal",
      "args": [
        "TRMSvftDebug"
      ],
      "justMyCode": false,
      // "autoReload": {
      //  "enable": true
      // },
      "env": {
        "DEBUG": "true",
      }
    },
    {
      "name": "trm cot full",
      "type": "debugpy",
      "request": "launch",
      "program": "./scripts/run.py",
      "console": "integratedTerminal",
      "args": [
        "TRMSvft",
        "--num-epochs=2", "--max_size=1000", "--lr=1e-2", "--gradient_accumulation_steps=1"
      ],
      "justMyCode": false,
      "autoReload": {
       "enable": true
      },
      "env": {
        // "DEBUG": "true",
      }
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
